+// Reuse the embedded Type3 source font: code 01 is BEH, code 04 is zero-width
+// FATHA with ink [200,900,300,1000]. These minimal pages already extract BEH
+// FATHA in v3; neither a lost mark nor an extra attached copy is acceptable.
+void CheckCombiningDuplicateFallback(FPDF_DOCUMENT document,
+                                     FPDF_FONT font,
+                                     const std::array<unsigned int, 3>& codes,
+                                     const std::array<float, 3>& sizes,
+                                     bool invisible_first) {
+  ScopedFPDFPage page(
+      FPDFPage_New(document, FPDF_GetPageCount(document), 300, 200));
+  ASSERT_TRUE(page);
+  for (size_t i = 0; i < codes.size(); ++i) {
+    ScopedFPDFPageObject text(
+        FPDFPageObj_CreateTextObj(document, font, sizes[i]));
+    ASSERT_TRUE(text);
+    ASSERT_TRUE(FPDFText_SetCharcodes(text.get(), &codes[i], 1));
+    ASSERT_TRUE(FPDFTextObj_SetTextRenderMode(
+        text.get(), invisible_first && i == 0 ? FPDF_TEXTRENDERMODE_INVISIBLE
+                                              : FPDF_TEXTRENDERMODE_FILL));
+    FPDFPageObj_Transform(text.get(), 1, 0, 0, 1, 100, 100);
+    FPDFPage_InsertObject(page.get(), text.release());
+  }
+  // Disable whole-page semantic reconstruction, which otherwise reintroduces
+  // duplicate marks even in v3. This zero-ink non-text scope emits no Unicode.
+  ScopedFPDFPageObject sentinel(FPDFPageObj_CreateNewRect(0, 0, 0, 0));
+  ASSERT_TRUE(sentinel);
+  const auto mark = FPDFPageObj_AddMark(sentinel.get(), "Span");
+  ASSERT_TRUE(mark);
+  ASSERT_TRUE(FPDFPageObjMark_SetStringParam(document, sentinel.get(), mark,
+                                             "ActualText", ""));
+  FPDFPage_InsertObject(page.get(), sentinel.release());
+  ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+  ASSERT_TRUE(text_page);
+  ASSERT_EQ(2, FPDFText_CountChars(text_page.get()));
+  unsigned short buffer[3] = {};
+  ASSERT_EQ(3, FPDFText_GetText(text_page.get(), 0, 2, buffer));
+  EXPECT_EQ(L"\u0628\u064e", GetPlatformWString(buffer));
+  const int mark_object = codes[1] == 4 ? 1 : 2;
+  for (int i : {0, 1}) {
+    SCOPED_TRACE(i);
+    const unsigned short expected = i == 0 ? 0x0628 : 0x064e;
+    EXPECT_EQ(expected, FPDFText_GetUnicode(text_page.get(), i));
+    unsigned short character[2] = {};
+    ASSERT_EQ(2, FPDFText_GetText(text_page.get(), i, 1, character));
+    EXPECT_EQ(expected, character[0]);
+    EXPECT_EQ(0, character[1]);
+    EXPECT_EQ(0, FPDFText_IsGenerated(text_page.get(), i));
+    EXPECT_EQ(FPDFPage_GetObject(page.get(), i == 0 ? 0 : mark_object),
+              FPDFText_GetTextObject(text_page.get(), i));
+    double x;
+    double y;
+    ASSERT_TRUE(FPDFText_GetCharOrigin(text_page.get(), i, &x, &y));
+    EXPECT_NEAR_THREE_PLACES(100, x);
+    EXPECT_NEAR_THREE_PLACES(100, y);
+    RectDouble box;
+    ASSERT_TRUE(FPDFText_GetCharBox(text_page.get(), i, &box.left, &box.right,
+                                    &box.bottom, &box.top));
+    CompareFS_RECT_DOUBLE_Three_Places(
+        i == 0
+            ? RectDouble{100, 100 + 0.8 * sizes[0], 100 + 0.4 * sizes[0], 100}
+            : RectDouble{104, 120, 106, 118},
+        box);
+  }
+  unsigned short mark_text[2] = {};
+  EXPECT_EQ(4u,
+            FPDFTextObj_GetText(FPDFPage_GetObject(page.get(), mark_object),
+                                text_page.get(), mark_text, sizeof(mark_text)));
+  EXPECT_EQ(L"\u064e", GetPlatformWString(mark_text));
+  const auto query = GetFPDFWideString(L"\u0628\u064e");
+  for (unsigned long flags :
+       {FPDF_MATCHCASE, FPDF_MATCHCASE | FPDF_MATCHWHOLEWORD}) {
+    ScopedFPDFTextFind search(
+        FPDFText_FindStart(text_page.get(), query.get(), flags, 0));
+    ASSERT_TRUE(search);
+    ASSERT_TRUE(FPDFText_FindNext(search.get()));
+    EXPECT_EQ(0, FPDFText_GetSchResultIndex(search.get()));
+    EXPECT_EQ(2, FPDFText_GetSchCount(search.get()));
+    EXPECT_FALSE(FPDFText_FindNext(search.get()));
+  }
+}
