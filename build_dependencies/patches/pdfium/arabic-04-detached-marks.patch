+                FPDFText_GetUnicode(text_page.get(), i));
+    }
+    const int start = page_index == 2 ? 4 : 0;
+    for (int offset : {1, 3}) {
+      const int index = start + offset;
+      const double source_x = offset == 1 ? 92 : 82;
+      const double source_y = page_index == 2 && offset == 3 ? 99.9 : 105;
