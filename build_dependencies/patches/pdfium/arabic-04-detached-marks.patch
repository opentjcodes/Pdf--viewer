+  ASSERT_TRUE(FPDFText_GetCharOrigin(text_page.get(), 1, &x, &y));
+  EXPECT_NEAR_THREE_PLACES(99.98, x);
+  EXPECT_NEAR_THREE_PLACES(100, y);
+  RectDouble box;
+  ASSERT_TRUE(FPDFText_GetCharBox(text_page.get(), 1, &box.left, &box.right,
+                                 &box.bottom, &box.top));
+  CompareFS_RECT_DOUBLE_Three_Places(RectDouble{98.4, 120, 102.4, 118}, box);
+  const auto query = GetFPDFWideString(L"\u0627\u064b");
+  ScopedFPDFTextFind search(
+      FPDFText_FindStart(text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+  ASSERT_TRUE(search);
+  ASSERT_TRUE(FPDFText_FindNext(search.get()));
+  EXPECT_EQ(0, FPDFText_GetSchResultIndex(search.get()));
+  EXPECT_EQ(2, FPDFText_GetSchCount(search.get()));
+  EXPECT_FALSE(FPDFText_FindNext(search.get()));
+}
