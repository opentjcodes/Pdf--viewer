+++ b/core/fpdftext/cpdf_textpage_combining.cpp
@@ -0,0 +1,474 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "core/fpdftext/cpdf_textpage.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <utility>
+
+#include "core/fpdfapi/font/cpdf_font.h"
+#include "core/fpdfapi/page/cpdf_form.h"
+#include "core/fpdfapi/page/cpdf_formobject.h"
+#include "core/fpdfapi/page/cpdf_page.h"
+#include "core/fpdfapi/page/cpdf_textobject.h"
+#include "core/fpdfapi/parser/cpdf_dictionary.h"
+#include "core/fpdftext/unicodenormalizationdata.h"
+#include "core/fxcrt/fx_extension.h"
+#include "core/fxcrt/fx_unicode.h"
+#include "core/fxcrt/span.h"
+
+namespace {
+
+// Matches the glyph dedup threshold in ProcessTextObjectItems().
+constexpr float kDuplicateRatio = 0.07f;
+
+// Use the text extractor's compatibility table for classification, not to
+// rewrite a base's explicit ToUnicode payload.
+DataVector<wchar_t> Normalize(wchar_t wc) {
+  if (static_cast<uint32_t>(wc) > 0xffff) {
+    return {wc};
+  }
+  const uint16_t entry = kUnicodeDataNormalization[wc];
+  if (!entry) {
+    return {wc};
+  }
+  if (entry >= 0x8000) {
+    return {kUnicodeDataNormalizationMap1[entry - 0x8000]};
+  }
+  static constexpr std::array<pdfium::span<const uint16_t>, 3> kMaps = {
+      kUnicodeDataNormalizationMap2, kUnicodeDataNormalizationMap3,
+      kUnicodeDataNormalizationMap4};
+  size_t count = entry >> 12;
+  auto mapping = kMaps[count - 2].subspan(static_cast<size_t>(entry & 0x0fff));
+  if (count == 4) {
+    count = mapping.front();
+    mapping = mapping.subspan<1>();
+  }
+  const auto range = mapping.first(count);
+  return DataVector<wchar_t>(range.begin(), range.end());
+}
+
+bool IsMark(wchar_t wc) {
+  if (pdfium::unicode::GetBidiClass(wc) == BidiClass::kNSM) {
+    return true;
+  }
+  const auto normalized = Normalize(wc);
+  return !normalized.empty() && std::ranges::all_of(normalized, [](wchar_t c) {
+    return pdfium::unicode::GetBidiClass(c) == BidiClass::kNSM;
+  });
+}
+
+bool HasActualText(const CPDF_PageObject* object) {
+  const CPDF_ContentMarks* marks = object->GetContentMarks();
+  for (size_t i = 0; i < marks->CountItems(); ++i) {
+    const auto dict = marks->GetItem(i)->GetParam();
+    if (dict && dict->KeyExist("ActualText")) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+void CPDF_TextPage::CollectCombiningMarks() {
+  attached_marks_.clear();
+  attached_mark_objects_.clear();
+
+  struct Glyph {
+    CharInfo info;
+    size_t item_index;
+    float em;
+    float x_em;
+    bool object_duplicate;
+  };
+  struct Placement {
+    const CPDF_TextObject* text;
+    size_t item_index;
+    size_t occurrence;
+    CFX_PointF origin;
+    float duplicate_distance;
+  };
+  struct PlacementIndex {
+    std::vector<Placement> glyphs;
+    float max_duplicate_distance = 0;
+  };
+  struct BaseIndex {
+    std::vector<Glyph> glyphs;
+    float max_width = 0;
+  };
+  struct MarkObject {
+    size_t occurrence;
+    std::vector<Glyph> glyphs;
+  };
+  std::map<size_t, std::map<const CPDF_Font*, BaseIndex>> indices;
+  std::map<const CPDF_Font*, std::map<uint32_t, PlacementIndex>> placements;
+  std::vector<MarkObject> mark_objects;
+  size_t base_count = 0;
+  size_t mark_count = 0;
+  size_t visited = 0;
+  size_t next_occurrence = 0;
+  // A page-wide fallback, never a prefix repair on an oversized page. Counting
+  // all objects/items also bounds work on non-text and unsupported content.
+  const auto collect = [&](auto&& self, const CPDF_PageObjectHolder* holder,
+                           const CFX_Matrix& form_matrix, size_t occurrence,
+                           bool excluded_scope, size_t depth) -> bool {
+    if (depth > 64) {
+      return false;
+    }
+    for (auto it = holder->begin(); it != holder->end(); ++it) {
+      const auto& object = *it;
+      if (++visited > 100000) {
+        return false;
+      }
+      if (!object->IsActive()) {
+        continue;
+      }
+      if (object->GetContentMarks()->CountItems() > 64) {
+        return false;
+      }
+      const bool excluded = excluded_scope || HasActualText(object.get()) ||
+                            object->general_state().GetFillAlpha() != 1.0f ||
+                            object->general_state().GetSoftMask();
+      if (object->IsForm()) {
+        // Exactly ProcessFormObject's active, depth-first invocation numbering,
+        // including empty/nested forms and forms excluded by ActualText.
+        const auto* form = object->AsForm();
+        const size_t child_occurrence = ++next_occurrence;
+        if (!self(self, form->form(), form->form_matrix() * form_matrix,
+                  child_occurrence, excluded, depth + 1)) {
+          return false;
+        }
+        continue;
+      }
+      CPDF_TextObject* text = object->AsText();
+      if (!text) {
+        continue;
+      }
+      const size_t item_count = text->CountItems();
+      if (item_count > 100000 - visited) {
+        return false;
+      }
+      visited += item_count;
+      const auto font = text->GetFont();
+      if (!font) {
+        continue;
+      }
+      const CFX_Matrix matrix = text->GetTextMatrix() * form_matrix;
+      const float em = text->GetFontSize() * matrix.d;
+      const float x_em = text->GetFontSize() * matrix.a;
+      const bool eligible =
+          !excluded && std::abs(text->GetRect().Width()) >= 0.01f &&
+          text->GetTextRenderMode() == TextRenderingMode::MODE_FILL &&
+          !font->IsVertWriting() && std::isfinite(em) && std::isfinite(x_em) &&
+          em > 0 && x_em > 0 && matrix.a > 0 && matrix.d > 0 &&
+          std::isfinite(matrix.b) && std::isfinite(matrix.c) &&
+          std::abs(matrix.b) <= matrix.a * 0.0001f &&
+          std::abs(matrix.c) <= matrix.d * 0.0001f;
+      // The nonempty-rect branch is independent of extraction state. Reuse the
+      // legacy predicate, including its lack of font/render-mode checks. Do not
+      // let a risky base disappear from scoring and make another owner win.
+      // Empty bounds depend on extraction state, so treat them as risky.
+      const bool object_duplicate =
+          eligible && (text->GetRect().IsEmpty() ||
+                       IsSameAsPreTextObject(text, holder, it));
+      const float duplicate_distance =
+          matrix.TransformXDistance(kDuplicateRatio * text->GetFontSize());
+      if (!std::isfinite(duplicate_distance)) {
+        return false;
+      }
+      std::vector<Glyph> marks;
+      bool mark_only = eligible && item_count != 0;
+      for (size_t i = 0; i < item_count; ++i) {
+        const auto item = text->GetItemInfo(i);
+        const CFX_PointF origin = matrix.Transform(item.origin_);
+        if (!std::isfinite(origin.x) || !std::isfinite(origin.y)) {
+          mark_only = false;
+          continue;
+        }
+        // Glyph dedup sees text excluded from attachment (including invisible,
+        // transparent and ActualText content), and ignores its font size. Keep
+        // those placements without decoding Unicode or loading their ink boxes.
+        auto& placement_index = placements[font.Get()][item.char_code_];
+        placement_index.glyphs.push_back(
+            {text, i, occurrence, origin, duplicate_distance});
+        placement_index.max_duplicate_distance = std::max(
+            placement_index.max_duplicate_distance, duplicate_distance);
+        if (!eligible) {
+          continue;
+        }
+        const WideString unicode = font->UnicodeFromCharCode(item.char_code_);
+        if (unicode.IsEmpty() || unicode.GetLength() > 32 ||
+            !std::ranges::all_of(unicode.span(), [](wchar_t wc) {
+              return u_isprint(wc) &&
+                     !u_hasBinaryProperty(wc,
+                                          UCHAR_DEFAULT_IGNORABLE_CODE_POINT);
+            })) {
+          mark_only = false;
+          continue;
+        }
+        const bool mark = std::ranges::all_of(unicode.span(), IsMark);
+        mark_only &= mark && font->GetCharWidth(item.char_code_) == 0;
+        size_t letters = 0;
+        bool base = !mark;
+        for (wchar_t wc : unicode) {
+          for (wchar_t c : Normalize(wc)) {
+            if (pdfium::unicode::GetBidiClass(c) == BidiClass::kNSM) {
+              continue;
+            }
+            if (c == 0x0640 || !FXSYS_iswalpha(c)) {
+              base = false;
+            }
+            ++letters;
+          }
+        }
+        base &= letters == 1 && font->GetCharWidth(item.char_code_) > 0;
+        const FX_RECT rect = font->GetCharBBox(item.char_code_);
+        const float scale = text->GetFontSize() / 1000;
+        const CFX_FloatRect box = matrix.TransformRect(
+            CFX_FloatRect(rect.left * scale + item.origin_.x,
+                          rect.bottom * scale + item.origin_.y,
+                          rect.right * scale + item.origin_.x,
+                          rect.top * scale + item.origin_.y));
+        // Unlike ordinary extraction, do not invent ink from advance widths.
+        if (!std::isfinite(box.left) || !std::isfinite(box.right) ||
+            !std::isfinite(box.bottom) || !std::isfinite(box.top) ||
+            box.IsEmpty() || box.Width() > 2 * x_em) {
+          mark_only = false;
+          continue;
+        }
+        Glyph glyph{CharInfo(CharType::kNormal, item.char_code_, 0, origin, box,
+                             matrix, text),
+                    i, em, x_em, object_duplicate};
+        if (mark && font->GetCharWidth(item.char_code_) == 0) {
+          if (++mark_count > 2000) {
+            return false;
+          }
+          marks.push_back(glyph);
+        } else if (base) {
+          if (++base_count > 20000) {
+            return false;
+          }
+          auto& index = indices[occurrence][font.Get()];
+          index.max_width = std::max(index.max_width, box.Width());
+          index.glyphs.push_back(glyph);
+        }
+      }
+      if (mark_only && !marks.empty()) {
+        mark_objects.push_back({occurrence, std::move(marks)});
+      }
+    }
+    return true;
+  };
+  if (!collect(collect, page_, CFX_Matrix(), 0, false, 0)) {
+    return;
+  }
+  for (auto& [font, codes] : placements) {
+    for (auto& [code, index] : codes) {
+      std::ranges::sort(index.glyphs, {}, [](const Placement& placement) {
+        return placement.origin.x;
+      });
+    }
+  }
+  const auto duplicate_risk = [&](const Glyph& glyph, size_t occurrence,
+                                  bool mark) {
+    if (glyph.object_duplicate) {
+      return true;
+    }
+    const auto& index = placements.at(glyph.info.text_object()->GetFont().Get())
+                            .at(glyph.info.char_code());
+    const CFX_PointF& origin = glyph.info.origin();
+    const float distance = glyph.info.matrix().TransformXDistance(
+        kDuplicateRatio * glyph.info.text_object()->GetFontSize());
+    // For marks, consider either dedup direction so a slightly larger duplicate
+    // cannot stay in legacy flow while its smaller twin gets attached first.
+    const float radius =
+        mark ? std::max(distance, index.max_duplicate_distance) : distance;
+    auto other = std::ranges::lower_bound(
+        index.glyphs, origin.x - radius, {},
+        [](const Placement& placement) { return placement.origin.x; });
+    size_t examined = 0;
+    for (; other != index.glyphs.end() && other->origin.x <= origin.x + radius;
+         ++other) {
+      if (++examined > 256) {
+        return true;
+      }
+      if (other->text == glyph.info.text_object() &&
+          other->item_index == glyph.item_index &&
+          other->occurrence == occurrence) {
+        continue;
+      }
+      const float threshold =
+          mark ? std::max(distance, other->duplicate_distance) : distance;
+      if (std::abs(other->origin.x - origin.x) < threshold &&
+          std::abs(other->origin.y - origin.y) < threshold) {
+        return true;
+      }
+    }
+    return false;
+  };
+  for (auto& [occurrence, fonts] : indices) {
+    for (auto& [font, index] : fonts) {
+      std::ranges::sort(index.glyphs, {}, [](const Glyph& glyph) {
+        return glyph.info.char_box().left;
+      });
+    }
+  }
+  for (const auto& object : mark_objects) {
+    const CPDF_TextObject* text = object.glyphs.front().info.text_object();
+    auto occurrence = indices.find(object.occurrence);
+    if (occurrence == indices.end()) {
+      continue;
+    }
+    auto font = occurrence->second.find(text->GetFont().Get());
+    if (font == occurrence->second.end()) {
+      continue;
+    }
+    const BaseIndex& index = font->second;
+    std::vector<const Glyph*> owners;
+    for (const Glyph& mark : object.glyphs) {
+      if (duplicate_risk(mark, object.occurrence, true)) {
+        break;
+      }
+      const auto& box = mark.info.char_box();
+      auto candidate = std::ranges::lower_bound(
+          index.glyphs, box.left - index.max_width, {},
+          [](const Glyph& glyph) { return glyph.info.char_box().left; });
+      const Glyph* best = nullptr;
+      float best_score = -1;
+      float runner_up = -1;
+      std::optional<float> baseline;
+      bool ambiguous = false;
+      size_t examined = 0;
+      for (; candidate != index.glyphs.end() &&
+             candidate->info.char_box().left < box.right;
+           ++candidate) {
+        // Dense overlapping columns/overprints fall back rather than doing
+        // O(marks * page glyphs) work. The x index bounds ordinary pages
+        // tightly.
+        if (++examined > 256) {
+          ambiguous = true;
+          break;
+        }
+        const Glyph& base = *candidate;
+        const auto& base_box = base.info.char_box();
+        const float dy = std::abs(mark.info.origin().y - base.info.origin().y);
+        if (std::abs(base.em - mark.em) > 0.02f * mark.em ||
+            std::abs(base.x_em - mark.x_em) > 0.02f * mark.x_em ||
+            dy > mark.em) {
+          continue;
+        }
+        // A centered mark can be wider than a thin stem. Measure coverage of
+        // the smaller ink extent; the competing-owner guards still apply.
+        const float overlap = (std::min(box.right, base_box.right) -
+                               std::max(box.left, base_box.left)) /
+                              std::min(box.Width(), base_box.Width());
+        if (overlap < 0.5f) {
+          continue;
+        }
+        // ILO's raised origins are +0.439/+0.344 em; OHCHR is -0.078 em
+        // and FAO -0.005 em (Tf=1 with Tm=12/13). A one-em window in
+        // page coordinates admits those, not a raw font-size/width threshold.
+        // Competing baselines are uncertain even if one ink overlap is better.
+        if (baseline &&
+            std::abs(*baseline - base.info.origin().y) > 0.1f * mark.em) {
+          ambiguous = true;
+        }
+        if (!baseline) {
+          baseline = base.info.origin().y;
+        }
+        const float center_distance =
+            std::abs((box.left + box.right) / 2 -
+                     (base_box.left + base_box.right) / 2) /
+            base_box.Width();
+        const float score =
+            overlap - 0.25f * center_distance - 0.125f * dy / mark.em;
+        if (score > best_score) {
+          runner_up = best_score;
+          best_score = score;
+          best = &base;
+        } else {
+          runner_up = std::max(runner_up, score);
+        }
+      }
+      // Never resolve ties by source order, object origin, or a nearby-index
+      // window. One unbound glyph keeps the entire mark object in legacy flow.
+      if (ambiguous || !best || best_score < 0.5f ||
+          best_score - runner_up < 0.15f ||
+          duplicate_risk(*best, object.occurrence, false)) {
+        break;
+      }
+      owners.push_back(best);
+    }
+    if (owners.size() != object.glyphs.size()) {
+      continue;
+    }
+    for (size_t i = 0; i < owners.size(); ++i) {
+      const Glyph& base = *owners[i];
+      const CharInfo& source = object.glyphs[i].info;
+      const WideString unicode =
+          text->GetFont()->UnicodeFromCharCode(source.char_code());
+      auto& attached =
+          attached_marks_[object.occurrence][base.info.text_object()]
+                         [base.item_index];
+      for (wchar_t wc : unicode) {
+        CharInfo info = source;
+        info.set_unicode(wc);
+        info.set_logical_unit(0, unicode.GetLength() > 1);
+        attached.push_back(info);
+      }
+    }
+    attached_mark_objects_[object.occurrence].insert(text);
+  }
+}
+
+bool CPDF_TextPage::IsAttachedMarkObject(const CPDF_TextObject* text_object,
+                                         size_t form_occurrence) const {
+  const auto occurrence = attached_mark_objects_.find(form_occurrence);
+  return occurrence != attached_mark_objects_.end() &&
+         occurrence->second.contains(text_object);
+}
+
+void CPDF_TextPage::AppendAttachedMarks(CPDF_TextObject* text_object,
+                                        size_t item_index,
+                                        size_t form_occurrence) {
+  const auto occurrence = attached_marks_.find(form_occurrence);
+  if (occurrence == attached_marks_.end()) {
+    return;
+  }
+  const auto object = occurrence->second.find(text_object);
+  if (object == occurrence->second.end()) {
+    return;
+  }
+  const auto item = object->second.find(item_index);
+  if (item == object->second.end() || temp_char_list_.empty() ||
+      temp_char_list_.back().text_object() != text_object) {
+    return;
+  }
+  CharInfo& base = temp_char_list_.back();
+  if (!base.logical_unit()) {
+    base.set_logical_unit(++next_logical_unit_, base.has_logical_unicode());
+  }
+  const uint32_t unit = base.logical_unit();
+  for (CharInfo mark : item->second) {
+    mark.set_logical_unit(unit, mark.has_logical_unicode());
+    mark.set_attached_mark();
+    // Only mark-only compatibility mappings may expand here. Base spelling,
+    // explicit mapping flags, source objects, origins and ink remain intact.
+    const auto unicode =
+        pdfium::unicode::GetBidiClass(mark.unicode()) == BidiClass::kNSM
+            ? DataVector<wchar_t>{mark.unicode()}
+            : Normalize(mark.unicode());
+    if (unicode.size() != 1 || unicode.front() != mark.unicode()) {
+      mark.set_char_type(CharType::kPiece);
+    }
+    for (wchar_t wc : unicode) {
+      mark.set_unicode(wc);
+      temp_char_list_.push_back(mark);
+      temp_text_buf_.AppendChar(wc);
+    }
+  }
+}
