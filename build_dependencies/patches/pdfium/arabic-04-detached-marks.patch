+    EXPECT_EQ(FPDFPage_GetObject(page.get(), 0), shadda);
+    if (page_index == 2) {
+      EXPECT_NE(shadda, FPDFText_GetTextObject(text_page.get(), start + 1));
+      // Both original spaces remain source characters of the whole base Tj.
+      for (int space : {1, 3}) {
