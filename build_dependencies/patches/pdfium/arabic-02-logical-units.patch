+TEST_F(FPDFTextEmbedderTest, ActualTextRtlMixedUnits) {
+  ASSERT_TRUE(OpenDocument("actualtext_rtl_units.pdf"));
+  // Page 0 paints [ActualText SHEEN], ordinary YA AIN LAM LAM. The replacement
+  // overrides the first glyph's SHEEN SHADDA KASRATAN mapping and moves last.
+  // Page 1 paints ordinary MIM BEH, then one logical LAM LAM AIN YA SHEEN
+  // replacement. Reverse source units, never the replacement's interior.
+  // Both targets are one RTL segment; each page's second baseline is MIM.
+  static constexpr struct {
+    const char* name;
+    int char_count;
+    std::array<unsigned short, 11> text;
+  } kCases[] = {
+      {"ActualTextFirst",
+       8,
+       {0x0644, 0x0644, 0x0639, 0x064a, 0x0634, '\r', '\n', 0x0645, 0}},
+      {"OrdinaryFirst",
+       10,
+       {0x0644, 0x0644, 0x0639, 0x064a, 0x0634, 0x0628, 0x0645, '\r', '\n',
+        0x0645, 0}},
+  };
+  ASSERT_EQ(static_cast<int>(std::size(kCases)), FPDF_GetPageCount(document()));
+  for (int page_index = 0; page_index < static_cast<int>(std::size(kCases));
+       ++page_index) {
+    const auto& test_case = kCases[page_index];
+    SCOPED_TRACE(test_case.name);
+    ScopedPage page = LoadScopedPage(page_index);
+    ASSERT_TRUE(page);
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    ASSERT_TRUE(text_page);
+    EXPECT_EQ(test_case.char_count, FPDFText_CountChars(text_page.get()));
+    std::array<unsigned short, 11> buffer = {};
+    EXPECT_EQ(test_case.char_count + 1,
+              FPDFText_GetText(text_page.get(), 0, test_case.char_count,
+                               buffer.data()));
+    const size_t text_size = static_cast<size_t>(test_case.char_count + 1);
+    EXPECT_THAT(
+        pdfium::span(buffer).first(text_size),
+        ElementsAreArray(pdfium::span(test_case.text).first(text_size)));
+    for (int i = 0; i < test_case.char_count; ++i) {
+      SCOPED_TRACE(i);
+      EXPECT_EQ(static_cast<unsigned int>(test_case.text[i]),
+                FPDFText_GetUnicode(text_page.get(), i));
+      unsigned short character[2] = {};
+      EXPECT_EQ(2, FPDFText_GetText(text_page.get(), i, 1, character));
+      EXPECT_EQ(test_case.text[i], character[0]);
+      EXPECT_EQ(0, character[1]);
+    }
+
+    static constexpr struct {
+      const wchar_t* text;
+      int index;
+      int count;
+    } kQueries[] = {
+        {L"\u0644\u0644\u0639\u064a\u0634", 0, 5},
+        {L"\u0634", 4, 1},
+    };
+    for (const auto& query_case : kQueries) {
+      SCOPED_TRACE(query_case.index);
+      ScopedFPDFWideString query = GetFPDFWideString(query_case.text);
+      ScopedFPDFTextFind search(
+          FPDFText_FindStart(text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+      ASSERT_TRUE(search);
+      EXPECT_TRUE(FPDFText_FindNext(search.get()));
+      EXPECT_EQ(query_case.index, FPDFText_GetSchResultIndex(search.get()));
+      EXPECT_EQ(query_case.count, FPDFText_GetSchCount(search.get()));
+      EXPECT_FALSE(FPDFText_FindNext(search.get()));
+    }
+  }
+}
