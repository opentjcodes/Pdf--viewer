+TEST_F(FPDFTextEmbedderTest, ArabicMarkedPresentationForm) {
+  ASSERT_TRUE(OpenDocument("arabic_marked_presentation.pdf"));
+  ASSERT_EQ(2, FPDF_GetPageCount(document()));
+  // An ordinary U+FE91 base must still normalize to BEH when a separate FATHA
+  // is attached by TJ back-kerning. A structural cluster is not logical text
+  // supplied by ActualText or a multi-codepoint mapping.
+  for (int page_index = 0; page_index < 2; ++page_index) {
+    SCOPED_TRACE(page_index);
+    const bool marked = page_index == 1;
+    const int expected_hits = marked ? 2 : 1;
+    const std::wstring expected = marked ? L"\u0628\u064e" : L"\u0628";
+    const int match_length = static_cast<int>(expected.size());
+    ScopedPage page = LoadScopedPage(page_index);
+    ASSERT_TRUE(page);
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    ASSERT_TRUE(text_page);
+    const int count = FPDFText_CountChars(text_page.get());
+    ASSERT_GE(count, expected_hits * match_length);
+    std::vector<unsigned short> buffer(count + 1);
+    ASSERT_EQ(count + 1,
+              FPDFText_GetText(text_page.get(), 0, count, buffer.data()));
+    const std::wstring text = GetPlatformWString(buffer.data());
+    // The marked page has two baselines; do not prescribe legacy CRLF output.
+    EXPECT_EQ(expected_hits, std::count(text.begin(), text.end(), L'\u0628'));
+    EXPECT_EQ(marked ? 2 : 0, std::count(text.begin(), text.end(), L'\u064e'));
+    EXPECT_EQ(std::wstring::npos, text.find(L"\ufe91"));
+    for (int i = 0; i < count; ++i) {
+      SCOPED_TRACE(i);
+      EXPECT_EQ(static_cast<unsigned int>(buffer[i]),
+                FPDFText_GetUnicode(text_page.get(), i));
+    }
+
+    ScopedFPDFWideString query = GetFPDFWideString(expected);
+    ScopedFPDFTextFind search(
+        FPDFText_FindStart(text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+    ASSERT_TRUE(search);
+    for (int hit = 0; hit < expected_hits; ++hit) {
+      SCOPED_TRACE(hit);
+      ASSERT_TRUE(FPDFText_FindNext(search.get()));
+      const int index = FPDFText_GetSchResultIndex(search.get());
+      ASSERT_GE(index, 0);
+      ASSERT_LE(index + match_length, count);
+      EXPECT_EQ(match_length, FPDFText_GetSchCount(search.get()));
+      unsigned short matched[3] = {};
+      EXPECT_EQ(match_length + 1, FPDFText_GetText(text_page.get(), index,
+                                                   match_length, matched));
+      EXPECT_EQ(expected, GetPlatformWString(matched));
+    }
+    EXPECT_FALSE(FPDFText_FindNext(search.get()));
+  }
+}
