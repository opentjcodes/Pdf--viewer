+TEST_F(FPDFTextEmbedderTest, ArabicLogicalUnitPunctuation) {
+  ASSERT_TRUE(OpenDocument("arabic_unit_boundaries.pdf"));
+  ASSERT_EQ(5, FPDF_GetPageCount(document()));
+  // The same explicit logical string comes from one ToUnicode mapping, then
+  // one ActualText occurrence. RTL movement must not mirror its LTR interior.
+  static constexpr unsigned short kExpectedText[] = {0x0628, ' ', 'A', 'B', 'C',
+                                                     ' ',    '(', 'D', ')', 0};
+  for (int page_index = 0; page_index < 2; ++page_index) {
+    SCOPED_TRACE(page_index);
+    ScopedPage page = LoadScopedPage(page_index);
+    ASSERT_TRUE(page);
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    ASSERT_TRUE(text_page);
+    EXPECT_EQ(9, FPDFText_CountChars(text_page.get()));
+    unsigned short buffer[10] = {};
+    EXPECT_EQ(10, FPDFText_GetText(text_page.get(), 0, 9, buffer));
+    EXPECT_THAT(buffer, ElementsAreArray(kExpectedText));
+    for (int i = 0; i < 9; ++i) {
+      SCOPED_TRACE(i);
+      EXPECT_EQ(static_cast<unsigned int>(kExpectedText[i]),
+                FPDFText_GetUnicode(text_page.get(), i));
+      unsigned short character[2] = {};
+      EXPECT_EQ(2, FPDFText_GetText(text_page.get(), i, 1, character));
+      EXPECT_EQ(kExpectedText[i], character[0]);
+      EXPECT_EQ(0, character[1]);
+    }
+    ScopedFPDFWideString query = GetFPDFWideString(L"\u0628 ABC (D)");
+    ScopedFPDFTextFind search(
+        FPDFText_FindStart(text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+    ASSERT_TRUE(search);
+    EXPECT_TRUE(FPDFText_FindNext(search.get()));
+    EXPECT_EQ(0, FPDFText_GetSchResultIndex(search.get()));
+    EXPECT_EQ(9, FPDFText_GetSchCount(search.get()));
+    EXPECT_FALSE(FPDFText_FindNext(search.get()));
+  }
+}
