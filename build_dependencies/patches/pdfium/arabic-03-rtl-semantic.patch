+       1,
+       3,
+       {1, 4, 7},
+       {140, 180, 160}},
+      {"ReversedAxesWithCompensatingPageRotation",
+       L"\u064e\u0628\u062a \u062c\u062d",
+       1,
+       2,
+       {1, 4, -1},
+       {120, 160, 0},
+       true},
+  };
+  ASSERT_EQ(static_cast<int>(std::size(kCases)), FPDF_GetPageCount(document()));
+  std::string upright_bitmap_hash;
+  for (int page_index = 0; page_index < static_cast<int>(std::size(kCases));
+       ++page_index) {
+    const auto& test_case = kCases[page_index];
+    SCOPED_TRACE(test_case.name);
+    ScopedPage page = LoadScopedPage(page_index);
+    ASSERT_TRUE(page);
+    if (page_index == 0 || test_case.reversed_axes) {
+      ScopedFPDFBitmap bitmap = RenderPage(page.get());
+      ASSERT_TRUE(bitmap);
+      if (page_index == 0) {
+        upright_bitmap_hash = HashBitmap(bitmap.get());
+      } else {
+        // Content rotation and /Rotate cancel visually, not in text geometry.
+        EXPECT_EQ(upright_bitmap_hash, HashBitmap(bitmap.get()));
+      }
+    }
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    ASSERT_TRUE(text_page);
+    const std::wstring expected(test_case.text);
+    const int count = static_cast<int>(expected.size());
+    ASSERT_EQ(count, FPDFText_CountChars(text_page.get()));
+    std::vector<unsigned short> buffer(count + 1);
+    ASSERT_EQ(count + 1,
+              FPDFText_GetText(text_page.get(), 0, count, buffer.data()));
+    EXPECT_EQ(expected, GetPlatformWString(buffer.data()));
+    for (int i = 0; i < count; ++i) {
+      SCOPED_TRACE(i);
+      EXPECT_EQ(static_cast<unsigned int>(expected[i]),
+                FPDFText_GetUnicode(text_page.get(), i));
+      unsigned short character[2] = {};
+      EXPECT_EQ(2, FPDFText_GetText(text_page.get(), i, 1, character));
+      EXPECT_EQ(static_cast<unsigned short>(expected[i]), character[0]);
+      EXPECT_EQ(0, character[1]);
+    }
+    if (test_case.reversed_axes) {
+      double x;
+      double y;
+      ASSERT_TRUE(FPDFText_GetCharOrigin(text_page.get(), 0, &x, &y));
+      EXPECT_NEAR_THREE_PLACES(120, x);
+      EXPECT_NEAR_THREE_PLACES(100, y);
+      RectDouble mark_box;
+      ASSERT_TRUE(FPDFText_GetCharBox(text_page.get(), 0, &mark_box.left,
+                                      &mark_box.right, &mark_box.bottom,
+                                      &mark_box.top));
+      CompareFS_RECT_DOUBLE_Three_Places({114, 82, 116, 80}, mark_box);
+    }
+    for (int word = 0; word < test_case.word_count; ++word) {
+      const int start = test_case.word_indices[word];
+      const double word_x = test_case.word_x[word];
+      for (int index = start; index < start + 2; ++index) {
+        SCOPED_TRACE(index);
+        double x;
+        double y;
+        ASSERT_TRUE(FPDFText_GetCharOrigin(text_page.get(), index, &x, &y));
+        EXPECT_NEAR_THREE_PLACES(word_x, x);
+        EXPECT_NEAR_THREE_PLACES(100, y);
+        RectDouble box;
+        ASSERT_TRUE(FPDFText_GetCharBox(text_page.get(), index, &box.left,
+                                        &box.right, &box.bottom, &box.top));
+        if (test_case.reversed_axes) {
+          // Public geometry stays in the source plane: x'=300-x, y'=200-y.
+          CompareFS_RECT_DOUBLE_Three_Places({word_x - 10, 100, word_x, 84},
+                                             box);
+          FS_MATRIX matrix;
+          ASSERT_TRUE(FPDFText_GetMatrix(text_page.get(), index, &matrix));
+          EXPECT_FLOAT_EQ(-1, matrix.a);
+          EXPECT_FLOAT_EQ(0, matrix.b);
+          EXPECT_FLOAT_EQ(0, matrix.c);
+          EXPECT_FLOAT_EQ(-1, matrix.d);
+        } else {
+          CompareFS_RECT_DOUBLE_Three_Places({word_x, 116, word_x + 10, 100},
+                                             box);
+        }
+      }
+      // Both codepoints share one glyph box. Equal-X overlapping glyphs have
+      // an ambiguous point hit, so do not prescribe their point-hit index.
+      if (page_index != 2) {
+        EXPECT_EQ(start, FPDFText_GetCharIndexAtPos(
+                             text_page.get(),
+                             word_x + (test_case.reversed_axes ? -5 : 5),
+                             test_case.reversed_axes ? 92 : 108, 0, 0));
+      }
+    }
+    ScopedFPDFWideString query =
+        GetFPDFWideString(L"\u0628\u062a \u062c\u062d");
+    for (unsigned long flags :
+         {FPDF_MATCHCASE, FPDF_MATCHCASE | FPDF_MATCHWHOLEWORD}) {
+      ScopedFPDFTextFind search(
+          FPDFText_FindStart(text_page.get(), query.get(), flags, 0));
+      ASSERT_TRUE(search);
+      ASSERT_TRUE(FPDFText_FindNext(search.get()));
+      EXPECT_EQ(test_case.query_index,
+                FPDFText_GetSchResultIndex(search.get()));
+      EXPECT_EQ(5, FPDFText_GetSchCount(search.get()));
+      unsigned short matched[6] = {};
+      EXPECT_EQ(6, FPDFText_GetText(text_page.get(), test_case.query_index, 5,
+                                    matched));
+      EXPECT_EQ(L"\u0628\u062a \u062c\u062d", GetPlatformWString(matched));
+      EXPECT_FALSE(FPDFText_FindNext(search.get()));
+    }
+  }
+}
+
+TEST_F(FPDFTextEmbedderTest, ViewerRtlPreservesLatinText) {
+  ASSERT_TRUE(OpenDocument("viewer_rtl_ltr_text.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+  ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+  ASSERT_TRUE(text_page);
+  const std::wstring expected =
+      L"https://example.com/path/file.pdf\r\n"
+      L"Indicators for Policy Management\r\n"
+      L"12-34";
+  ASSERT_EQ(static_cast<int>(expected.size()),
+            FPDFText_CountChars(text_page.get()));
+  std::vector<unsigned short> buffer(expected.size() + 1);
+  ASSERT_EQ(static_cast<int>(buffer.size()),
+            FPDFText_GetText(text_page.get(), 0,
+                             static_cast<int>(expected.size()), buffer.data()));
+  EXPECT_EQ(expected, GetPlatformWString(buffer.data()));
+  for (size_t i = 0; i < expected.size(); ++i) {
+    EXPECT_EQ(static_cast<unsigned int>(expected[i]),
+              FPDFText_GetUnicode(text_page.get(), i));
+  }
+  for (const auto& [query_text, offset] :
+       std::array<std::pair<const wchar_t*, int>, 3>{{
+           {L"https://example.com/path/file.pdf", 0},
+           {L"Indicators for Policy Management", 35},
+           {L"12-34", 69}}}) {
+    const auto query = GetFPDFWideString(query_text);
+    ScopedFPDFTextFind search(FPDFText_FindStart(
+        text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+    ASSERT_TRUE(search);
+    ASSERT_TRUE(FPDFText_FindNext(search.get()));
+    EXPECT_EQ(offset, FPDFText_GetSchResultIndex(search.get()));
+    EXPECT_EQ(static_cast<int>(std::wstring_view(query_text).size()),
+              FPDFText_GetSchCount(search.get()));
+    EXPECT_FALSE(FPDFText_FindNext(search.get()));
+  }
+}
