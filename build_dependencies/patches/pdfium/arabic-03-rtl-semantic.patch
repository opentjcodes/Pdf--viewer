+    }
+    SemanticUnit& base = clusters.back();
+    const float center = unit.ink.left / 2 + unit.ink.right / 2;
+    if (base.direction != UnitDirection::kRight ||
+        base.invocation != unit.invocation || base.actual_text ||
+        std::fabs(base.em - unit.em) > base.em * 0.1f ||
+        std::fabs(base.origin.y - unit.origin.y) > base.em * 0.8f ||
+        center < base.left - base.em * 0.2f ||
+        center > base.right + base.em * 0.2f ||
+        unit.ink.bottom > base.ink.top + base.em * 0.5f ||
+        unit.ink.top < base.ink.bottom - base.em * 0.5f) {
+      return false;
+    }
+    // Adjacency proposes an attachment; reject it when another compatible
+    // base is as close horizontally. This is not general shaping recovery.
+    const float distance = std::fabs(center - base.Center());
+    for (const SemanticUnit& other : units) {
+      if (other.source_index == base.source_index || !other.has_base ||
+          other.direction != UnitDirection::kRight ||
+          other.invocation != base.invocation ||
+          std::fabs(other.origin.y - base.origin.y) > base.em * 0.08f) {
+        continue;
+      }
+      if (std::fabs(center - other.Center()) <= distance + base.em * 0.02f) {
+        return false;
+      }
+    }
+    base.text += unit.text;
+    base.chars.insert(base.chars.end(), unit.chars.begin(), unit.chars.end());
+    base.ink.Union(unit.ink);
+  }
+
+  size_t right_count = 0;
+  size_t left_count = 0;
+  bool has_island = false;
+  std::optional<float> baseline;
+  float line_em = 0;
+  for (const SemanticUnit& unit : clusters) {
+    for (wchar_t c : unit.text) {
+      const BidiClass bidi = pdfium::unicode::GetBidiClass(c);
+      right_count += bidi == BidiClass::kR || bidi == BidiClass::kAL;
+      left_count += bidi == BidiClass::kL;
+    }
+    has_island |= IsIslandMember(unit.direction);
+    if (unit.direction == UnitDirection::kSpace) {
+      continue;
+    }
+    if (!baseline) {
+      baseline = unit.origin.y;
+      line_em = unit.em;
+    }
+    if (std::fabs(unit.origin.y - *baseline) > line_em * 0.08f ||
+        std::fabs(unit.em - line_em) > line_em * 0.1f) {
+      return false;
+    }
+  }
+  if (!baseline || right_count <= left_count || (!complex && !has_island)) {
+    return false;
+  }
+  for (const SemanticUnit& unit : clusters) {
+    if (std::fabs(unit.origin.y - *baseline) > line_em * 0.08f ||
+        unit.right <= unit.left) {
+      return false;
+    }
+  }
+
+  const auto get_visual_order =
+      [&](std::u16string logical, const std::vector<size_t>& owners,
+          CFX_BidiResolver::ParagraphDirection direction)
+      -> std::optional<std::vector<size_t>> {
+    if (owners.empty() || owners.size() > kMaxCharacters) {
+      return std::nullopt;
+    }
+    auto bidi = CFX_BidiResolver::Create(std::move(logical), direction);
+    if (!bidi) {
+      return std::nullopt;
+    }
+    const auto runs =
+        bidi->GetVisualRunsForLine(0, static_cast<int>(owners.size()));
+    if (runs.empty()) {
+      return std::nullopt;
+    }
+    std::vector<size_t> visual;
+    for (const auto& run : runs) {
+      for (int i = 0; i < run.length; ++i) {
+        const size_t owner =
+            owners[run.start + (run.is_rtl ? run.length - i - 1 : i)];
+        if (visual.empty() || visual.back() != owner ||
+            owner == kSeparatorOwner) {
+          visual.push_back(owner);
+        }
+      }
+    }
+    return visual;
+  };
+
+  // Preserve a competing logical interpretation before sorting or inference.
+  // Unit identities also distinguish equal text at different occurrences.
+  std::vector<size_t> source_order;
+  std::u16string source_logical;
+  std::vector<size_t> source_owners;
+  for (const SemanticUnit& unit : clusters) {
+    source_order.push_back(unit.source_index);
+    for (wchar_t c : unit.text) {
+      source_logical.push_back(static_cast<char16_t>(c));
+      source_owners.push_back(unit.source_index);
+    }
+  }
+  const auto source_ltr_visual =
+      get_visual_order(std::move(source_logical), source_owners,
+                       CFX_BidiResolver::ParagraphDirection::kLeftToRight);
+  if (!source_ltr_visual) {
+    return false;
+  }
+
+  std::stable_sort(clusters.begin(), clusters.end(),
+                   [](const SemanticUnit& a, const SemanticUnit& b) {
+                     return a.Center() < b.Center();
+                   });
+  std::vector<size_t> spatial_source_order;
+  for (const SemanticUnit& unit : clusters) {
+    spatial_source_order.push_back(unit.source_index);
+  }
+  const bool source_ltr_matches_geometry =
+      *source_ltr_visual == spatial_source_order;
+  const auto rightmost_strong = std::find_if(
+      clusters.rbegin(), clusters.rend(), [](const SemanticUnit& unit) {
+        return unit.direction == UnitDirection::kRight ||
+               unit.direction == UnitDirection::kLeft;
+      });
+  if (rightmost_strong == clusters.rend() ||
+      rightmost_strong->direction != UnitDirection::kRight) {
+    return false;
+  }
+  if (clusters.front().direction == UnitDirection::kSpace ||
+      clusters.back().direction == UnitDirection::kSpace) {
+    return false;
+  }
+
+  units.clear();
+  for (SemanticUnit& unit : clusters) {
+    if (!units.empty()) {
+      const SemanticUnit& previous = units.back();
+      const float center_delta = unit.Center() - previous.Center();
+      if (center_delta < line_em * 0.01f) {
+        return false;
+      }
+      const float gap = unit.left - previous.right;
+      if (gap > line_em * 2) {
+        return false;
+      }
+      const float threshold =
+          std::max(line_em * 0.12f,
+                   std::min(previous.space_width, unit.space_width) * 0.5f);
+      if (gap > threshold && previous.direction != UnitDirection::kSpace &&
+          unit.direction != UnitDirection::kSpace) {
+        SemanticUnit space;
+        space.text = L" ";
+        space.direction = UnitDirection::kSpace;
+        space.left = previous.right;
+        space.right = unit.left;
+        space.origin = CFX_PointF(space.left, *baseline);
+        space.em = line_em;
+        space.chars.emplace_back(
+            CharType::kGenerated, CPDF_Font::kInvalidCharCode, L' ',
+            space.origin,
+            CFX_FloatRect(space.left, *baseline, space.left, *baseline),
+            CFX_Matrix(), nullptr);
+        units.push_back(std::move(space));
+      }
+    }
+    units.push_back(std::move(unit));
+  }
+
+  // Verify legacy against the semantic units, independently of paint order.
+  // Failure to identify provenance is uncertainty, not permission to repair.
+  struct Provenance {
+    size_t unit;
+    const CharInfo* info;
+  };
+  using Locations = std::map<std::pair<float, float>, std::vector<Provenance>>;
+  std::map<const CPDF_TextObject*, std::map<uint32_t, Locations>> provenance;
+  std::vector<size_t> expected_visual;
+  for (size_t i = 0; i < units.size(); ++i) {
+    const SemanticUnit& unit = units[i];
+    if (unit.direction == UnitDirection::kSpace) {
+      expected_visual.insert(expected_visual.end(), unit.text.GetLength(),
+                             kSeparatorOwner);
+    } else {
+      expected_visual.push_back(i);
+    }
+    const auto& sources =
+        unit.actual_text ? unit.replacement_sources : unit.chars;
+    const CharInfo* previous = nullptr;
+    for (const CharInfo& info : sources) {
+      if (!info.text_object()) {
+        continue;
+      }
+      if (!previous || previous->text_object() != info.text_object() ||
+          previous->char_code() != info.char_code() ||
+          previous->origin() != info.origin() ||
+          previous->matrix() != info.matrix()) {
+        provenance[info.text_object()][info.char_code()]
+                  [{info.origin().x, info.origin().y}]
+                      .push_back({i, &info});
+      }
+      previous = &info;
+    }
+  }
+  bool legacy_consistent = true;
+  std::vector<size_t> consumed(units.size());
+  std::u16string legacy_logical;
+  std::vector<size_t> legacy_owners;
+  size_t last_owner = kSeparatorOwner;
+  for (const CharInfo& info : char_list_) {
+    // RTL normalization can reclassify a generated space as kPiece, while
+    // retaining its absent glyph provenance.
+    if (info.char_type() == CharType::kGenerated || !info.text_object()) {
+      if (info.unicode() == L'\r' || info.unicode() == L'\n') {
+        // The independently collected base geometry established a single line.
+        legacy_consistent = false;
+        continue;
+      }
+      if (info.unicode() != L' ') {
+        return false;
+      }
+      legacy_logical.push_back(u' ');
+      legacy_owners.push_back(kSeparatorOwner);
+      last_owner = kSeparatorOwner;
+      continue;
+    }
+    auto object = provenance.find(info.text_object());
+    if (object == provenance.end()) {
+      return false;
+    }
+    auto code = object->second.find(info.char_code());
+    if (code == object->second.end()) {
+      if (info.char_code() == CPDF_Font::kInvalidCharCode &&
+          info.unicode() == L' ') {
+        legacy_logical.push_back(u' ');
+        legacy_owners.push_back(kSeparatorOwner);
+        last_owner = kSeparatorOwner;
+        continue;
+      }
+      return false;
+    }
+    if (!std::isfinite(info.origin().x) || !std::isfinite(info.origin().y)) {
+      return false;
+    }
+    // Both paths transform the same stored item origins. Exact location keys
+    // avoid quadratic scans when one text object repeats a glyph many times.
+    auto location = code->second.find({info.origin().x, info.origin().y});
+    if (location == code->second.end()) {
+      return false;
+    }
+    std::optional<size_t> owner;
+    for (const Provenance& witness : location->second) {
+      if (info.matrix() != witness.info->matrix()) {
+        continue;
+      }
+      if (owner && *owner != witness.unit) {
+        return false;
+      }
+      owner = witness.unit;
+    }
+    if (!owner) {
+      return false;
+    }
+    const SemanticUnit& unit = units[*owner];
+    if (unit.direction == UnitDirection::kSpace) {
+      if (info.unicode() != L' ') {
+        return false;
+      }
+      legacy_owners.push_back(kSeparatorOwner);
+      last_owner = kSeparatorOwner;
+    } else {
+      const size_t offset = consumed[*owner]++;
+      if (offset >= unit.chars.size() ||
+          (offset != 0 && last_owner != *owner)) {
+        legacy_consistent = false;
+      } else {
+        const CharInfo& expected = unit.chars[offset];
+        if (info.unicode() != expected.unicode() ||
+            (!unit.actual_text &&
+             (info.text_object() != expected.text_object() ||
+              info.char_code() != expected.char_code() ||
+              info.origin() != expected.origin()))) {
+          legacy_consistent = false;
+        }
+      }
+      legacy_owners.push_back(*owner);
+      last_owner = *owner;
+    }
+    legacy_logical.push_back(static_cast<char16_t>(info.unicode()));
+  }
+  for (size_t i = 0; i < units.size(); ++i) {
+    if (units[i].direction != UnitDirection::kSpace &&
+        consumed[i] != units[i].chars.size()) {
+      legacy_consistent = false;
+    }
+  }
+  if (legacy_consistent) {
+    for (auto direction :
+         {CFX_BidiResolver::ParagraphDirection::kLeftToRight,
+          CFX_BidiResolver::ParagraphDirection::kRightToLeft}) {
+      const auto visual =
+          get_visual_order(legacy_logical, legacy_owners, direction);
+      if (!visual || *visual == expected_visual) {
+        return false;
+      }
+    }
+  }
+
+  // LTR/numeric islands contain only spatial neighbors. A weak punctuation
+  // unit joins an island only between members, never as terminal punctuation.
+  std::vector<size_t> island_begin(units.size());
+  std::iota(island_begin.begin(), island_begin.end(), 0);
+  for (size_t i = 0; i < units.size(); ++i) {
+    if (!IsIslandMember(units[i].direction)) {
+      continue;
+    }
+    size_t end = i + 1;
+    while (end < units.size()) {
+      if (IsIslandMember(units[end].direction)) {
+        ++end;
+      } else if (units[end].direction == UnitDirection::kNeutral &&
+                 end + 1 < units.size() &&
+                 IsIslandMember(units[end + 1].direction)) {
+        end += 2;
+      } else {
+        break;
+      }
+    }
+    for (size_t j = i; j < end; ++j) {
+      island_begin[j] = i;
+    }
+    i = end - 1;
+  }
+  std::vector<size_t> order;
+  for (size_t end = units.size(); end > 0;) {
+    const size_t begin = island_begin[end - 1];
+    for (size_t i = begin; i < end; ++i) {
+      order.push_back(i);
+    }
+    end = begin;
+  }
+
+  if (source_ltr_matches_geometry) {
+    std::vector<size_t> rtl_source_order;
+    for (size_t index : order) {
+      const SemanticUnit& unit = units[index];
+      // A newly inferred space is not a change in source-unit reading order.
+      if (unit.chars.front().char_type() != CharType::kGenerated) {
+        rtl_source_order.push_back(unit.source_index);
+      }
+    }
+    if (rtl_source_order != source_order) {
+      return false;
+    }
+  }
+
+  std::u16string logical;
+  std::vector<size_t> owners;
+  for (size_t index : order) {
+    for (wchar_t c : units[index].text) {
+      logical.push_back(static_cast<char16_t>(c));
+      owners.push_back(index);
+    }
+  }
+  // Excluding the source-LTR interpretation is containment, not a unique
+  // inverse: a different logical stream can still share this visual order.
+  const auto visual =
+      get_visual_order(std::move(logical), owners,
+                       CFX_BidiResolver::ParagraphDirection::kRightToLeft);
+  if (!visual || visual->size() != units.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < visual->size(); ++i) {
+    if ((*visual)[i] != i) {
+      return false;
+    }
+  }
+
+  std::vector<CharInfo> result;
+  for (size_t index : order) {
+    const auto& chars = units[index].chars;
+    result.insert(result.end(), chars.begin(), chars.end());
+  }
+  char_list_.clear();
+  text_buf_.Delete(0, text_buf_.GetLength());
+  for (const CharInfo& info : result) {
+    text_buf_.AppendChar(info.unicode());
+    char_list_.push_back(info);
+  }
+  return true;
+}
