+#include "core/fpdfapi/page/cpdf_formobject.h"
+#include "core/fpdfapi/page/cpdf_page.h"
+#include "core/fpdfapi/page/cpdf_textobject.h"
+#include "core/fpdfapi/parser/cpdf_dictionary.h"
+#include "core/fpdfapi/parser/cpdf_string.h"
+#include "core/fxcrt/cfx_bidi_resolver.h"
+#include "core/fxcrt/fx_unicode.h"
+
+namespace {
+
+enum class UnitDirection { kRight, kLeft, kNumber, kNeutral, kSpace, kMark };
+
+struct SemanticUnit {
+  float Center() const { return left / 2 + right / 2; }
+
+  WideString text;
+  std::vector<CPDF_TextPage::CharInfo> chars;
+  std::vector<CPDF_TextPage::CharInfo> replacement_sources;
+  UnitDirection direction = UnitDirection::kNeutral;
+  CFX_FloatRect ink;
+  CFX_PointF origin;
+  CFX_Matrix matrix;
+  UnownedPtr<CPDF_TextObject> object;
+  float left = 0;
+  float right = 0;
+  float em = 0;
+  float space_width = 0;
+  size_t invocation = 0;
+  size_t source_index = 0;
+  bool actual_text = false;
+  bool has_base = false;
+};
+
+std::optional<UnitDirection> Classify(WideStringView text) {
+  if (text.IsEmpty()) {
+    return std::nullopt;
+  }
+  bool right = false;
+  bool left = false;
+  bool number = false;
+  bool all_marks = true;
+  bool all_spaces = true;
+  for (wchar_t c : text) {
+    // This bounded path does not interpret bidi controls, surrogate code units,
+    // presentation-form normalization, or non-printing extraction sentinels.
+    if (c < 0x20 || (c >= 0x7f && c <= 0x9f) || c == 0x061c ||
+        (c >= 0x200b && c <= 0x200f) || (c >= 0x2028 && c <= 0x202e) ||
+        (c >= 0x2060 && c <= 0x206f) || (c >= 0xd800 && c <= 0xdfff) ||
+        (c >= 0xfb00 && c <= 0xfdff) || c >= 0xfe70) {
+      return std::nullopt;
+    }
+    const BidiClass bidi = pdfium::unicode::GetBidiClass(c);
+    if (bidi == BidiClass::kBN) {
+      return std::nullopt;
+    }
+    right |= bidi == BidiClass::kR || bidi == BidiClass::kAL;
+    left |= bidi == BidiClass::kL;
+    number |= bidi == BidiClass::kAN || bidi == BidiClass::kEN;
+    all_marks &= bidi == BidiClass::kNSM;
+    all_spaces &= c == L' ';
+  }
+  if (right && (left || number)) {
+    return std::nullopt;
+  }
+  if (all_marks) {
+    return UnitDirection::kMark;
+  }
+  if (all_spaces) {
+    return UnitDirection::kSpace;
+  }
+  if (right) {
+    return UnitDirection::kRight;
+  }
+  if (left) {
+    return UnitDirection::kLeft;
+  }
+  return number ? UnitDirection::kNumber : UnitDirection::kNeutral;
+}
+
+bool IsIslandMember(UnitDirection direction) {
+  return direction == UnitDirection::kLeft ||
+         direction == UnitDirection::kNumber;
+}
