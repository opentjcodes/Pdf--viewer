+TEST_F(FPDFTextEmbedderTest, ArabicVisualWordOrder) {
+  ASSERT_TRUE(OpenDocument("arabic_visual_units.pdf"));
+  ASSERT_EQ(2, FPDF_GetPageCount(document()));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+  ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+  ASSERT_TRUE(text_page);
+
+  // At y=150, increasing x paints LAM KAF, DAL JEEM, BEH ALEF, with spaces.
+  // Reading right-to-left must reverse word order as well as each word.
+  // The unrelated ALEF at y=110 keeps this on the multiline extraction path.
+  static constexpr unsigned short kExpectedText[] = {
+      0x0627, 0x0628, ' ',  0x062c, 0x062f, ' ',
+      0x0643, 0x0644, '\r', '\n',   0x0627, 0};
+  static constexpr int kCharCount = std::size(kExpectedText) - 1;
+  EXPECT_EQ(kCharCount, FPDFText_CountChars(text_page.get()));
+  unsigned short buffer[std::size(kExpectedText)] = {};
+  EXPECT_EQ(kCharCount + 1,
+            FPDFText_GetText(text_page.get(), 0, kCharCount, buffer));
+  EXPECT_THAT(buffer, ElementsAreArray(kExpectedText));
+  for (int i = 0; i < kCharCount; ++i) {
+    SCOPED_TRACE(i);
+    EXPECT_EQ(static_cast<unsigned int>(kExpectedText[i]),
+              FPDFText_GetUnicode(text_page.get(), i));
+  }
+
+  ScopedFPDFWideString query =
+      GetFPDFWideString(L"\u0627\u0628 \u062c\u062f \u0643\u0644");
+  ScopedFPDFTextFind search(
+      FPDFText_FindStart(text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+  ASSERT_TRUE(search);
+  ASSERT_TRUE(FPDFText_FindNext(search.get()));
+  EXPECT_EQ(0, FPDFText_GetSchResultIndex(search.get()));
+  EXPECT_EQ(8, FPDFText_GetSchCount(search.get()));
+  EXPECT_FALSE(FPDFText_FindNext(search.get()));
+}
