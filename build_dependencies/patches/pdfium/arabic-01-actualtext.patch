+void CPDF_TextPage::CollectActualTextBounds(const CPDF_PageObjectHolder* holder,
+                                            size_t form_occurrence,
+                                            size_t& next_form_occurrence) {
+  for (const auto& page_obj : *holder) {
+    if (!page_obj->IsActive()) {
+      continue;
+    }
+    if (page_obj->IsForm()) {
+      // Match the depth-first invocation numbering in ProcessFormObject().
+      const size_t occurrence = ++next_form_occurrence;
+      CollectActualTextBounds(page_obj->AsForm()->form(), occurrence,
+                              next_form_occurrence);
+      continue;
+    }
+    if (!page_obj->IsText()) {
+      continue;
+    }
+
+    const CPDF_ContentMarks* marks = page_obj->GetContentMarks();
+    const CPDF_ContentMarkItem* actual_text_item = nullptr;
+    for (size_t i = 0; i < marks->CountItems(); ++i) {
+      const CPDF_ContentMarkItem* item = marks->GetItem(i);
+      RetainPtr<const CPDF_Dictionary> dict = item->GetParam();
+      if (dict && dict->GetStringFor("ActualText")) {
+        actual_text_item = item;
+      }
+    }
+    if (!actual_text_item) {
+      continue;
+    }
+
+    auto& bounds = actual_text_bounds_[form_occurrence];
+    auto [it, inserted] =
+        bounds.try_emplace(actual_text_item, page_obj->GetRect());
+    if (!inserted) {
+      it->second.Union(page_obj->GetRect());
+    }
+  }
+}
