+TEST_F(FPDFTextEmbedderTest, ActualTextFormTransform) {
+  ASSERT_TRUE(OpenDocument("actualtext_form_transform.pdf"));
+
+  // Type 3 glyph bounds and the text matrix give local boxes
+  // A=[10 20 20 44], B=[20 20 30 44]. Transform each local slice.
+  static constexpr struct {
+    const char* name;
+    FS_RECTF boxes[2];
+    double origin_x;
+    double origin_y;
+  } kCases[] = {
+      {"ordinary", {{10, 44, 20, 20}, {20, 44, 30, 20}}, 10, 20},
+      {"identity", {{10, 44, 20, 20}, {20, 44, 30, 20}}, 10, 20},
+      {"translated", {{110, 244, 120, 220}, {120, 244, 130, 220}}, 110, 220},
+      {"scaled", {{120, 332, 140, 260}, {140, 332, 160, 260}}, 120, 260},
+      {"nested_y_reflection", {{147, 324, 167, 252}, {167, 324, 187, 252}},
+       147, 324},
+      {"nested_x_reflection", {{259, 282, 279, 210}, {239, 282, 259, 210}},
+       279, 210},
+      {"nested_rotation", {{248, 171, 320, 151}, {248, 191, 320, 171}},
+       320, 151},
+  };
+  static constexpr unsigned short kExpectedText[] = {'A', 'B', 0};
+  ASSERT_EQ(static_cast<int>(std::size(kCases)), FPDF_GetPageCount(document()));
+  for (int page_index = 0; page_index < static_cast<int>(std::size(kCases));
+       ++page_index) {
+    const auto& test_case = kCases[page_index];
+    SCOPED_TRACE(test_case.name);
+    ScopedPage page = LoadScopedPage(page_index);
+    ASSERT_TRUE(page);
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    ASSERT_TRUE(text_page);
+    EXPECT_EQ(2, FPDFText_CountChars(text_page.get()));
+    unsigned short buffer[4] = {};
+    EXPECT_EQ(3, FPDFText_GetText(text_page.get(), 0, 3, buffer));
+    EXPECT_THAT(pdfium::span(buffer).first<3>(), ElementsAreArray(kExpectedText));
+    double x;
+    double y;
+    ASSERT_TRUE(FPDFText_GetCharOrigin(text_page.get(), 0, &x, &y));
+    EXPECT_NEAR_THREE_PLACES(test_case.origin_x, x);
+    EXPECT_NEAR_THREE_PLACES(test_case.origin_y, y);
+    for (int char_index = 0; char_index < 2; ++char_index) {
+      SCOPED_TRACE(char_index);
+      const auto& expected = test_case.boxes[char_index];
+      RectDouble tight;
+      ASSERT_TRUE(FPDFText_GetCharBox(text_page.get(), char_index, &tight.left,
+                                     &tight.right, &tight.bottom, &tight.top));
+      CompareFS_RECT_DOUBLE_Three_Places(
+          {expected.left, expected.top, expected.right, expected.bottom}, tight);
+      FS_RECTF loose;
+      ASSERT_TRUE(FPDFText_GetLooseCharBox(text_page.get(), char_index, &loose));
+      CompareFS_RECTF_Three_Places(expected, loose);
+      unsigned short bounded[2] = {};
+      EXPECT_EQ(2, FPDFText_GetBoundedText(
+                       text_page.get(), expected.left + 0.1, expected.top - 0.1,
+                       expected.right - 0.1, expected.bottom + 0.1, bounded,
+                       std::size(bounded)));
+      EXPECT_EQ(kExpectedText[char_index], bounded[0]);
+      EXPECT_EQ(0, bounded[1]);
+      EXPECT_EQ(char_index,
+                FPDFText_GetCharIndexAtPos(
+                    text_page.get(), (expected.left + expected.right) / 2,
+                    (expected.bottom + expected.top) / 2, 0, 0));
+    }
+  }
+}
+
+TEST_F(FPDFTextEmbedderTest, ActualTextInterleaved) {
+  ASSERT_TRUE(OpenDocument("actualtext_interleaved.pdf"));
+  static constexpr struct {
+    std::array<unsigned short, 3> text;
+    int char_count;
+    int a_count;
+  } kCases[] = {
+      {{'A', 'B', 0}, 2, 1}, {{'A', 'B', 0}, 2, 1},
+      {{'A', 'A', 0}, 2, 2}, {{'A', 0, 0}, 1, 1},
+      {{'A', 'A', 0}, 2, 2}, {{'A', 'A', 0}, 2, 2},
+      {{'A', 'A', 0}, 2, 2}, {{'A', 0, 0}, 1, 1},
+  };
+  ASSERT_EQ(static_cast<int>(std::size(kCases)), FPDF_GetPageCount(document()));
+  // Cover interleaving, reused property dictionaries, nested non-replacement
+  // marks, separate equal-payload spans, and repeated Form invocations.
+  for (int page_index = 0; page_index < static_cast<int>(std::size(kCases));
+       ++page_index) {
+    SCOPED_TRACE(page_index);
+    const auto& test_case = kCases[page_index];
+    ScopedPage page = LoadScopedPage(page_index);
+    ASSERT_TRUE(page);
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    ASSERT_TRUE(text_page);
+    EXPECT_EQ(test_case.char_count, FPDFText_CountChars(text_page.get()));
+    unsigned short buffer[4] = {};
+    EXPECT_EQ(test_case.char_count + 1,
+              FPDFText_GetText(text_page.get(), 0, 3, buffer));
+    const size_t text_size = static_cast<size_t>(test_case.char_count + 1);
+    EXPECT_THAT(pdfium::span(buffer).first(text_size),
+                ElementsAreArray(pdfium::span(test_case.text)
+                                     .first(text_size)));
+    ScopedFPDFWideString query = GetFPDFWideString(L"A");
+    ScopedFPDFTextFind search(
+        FPDFText_FindStart(text_page.get(), query.get(), FPDF_MATCHCASE, 0));
+    ASSERT_TRUE(search);
+    for (int index = 0; index < test_case.a_count; ++index) {
+      ASSERT_TRUE(FPDFText_FindNext(search.get()));
+      EXPECT_EQ(index, FPDFText_GetSchResultIndex(search.get()));
+      EXPECT_EQ(1, FPDFText_GetSchCount(search.get()));
+    }
+    EXPECT_FALSE(FPDFText_FindNext(search.get()));
+  }
+}
